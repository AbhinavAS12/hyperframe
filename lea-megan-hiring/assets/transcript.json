  },
  {
   "start": 20.22,
   "end": 22.57,
   "parakeet": "So what can they expect here?",
   "whisper": "So what can they expect here?"
  },
  {
   "start": 22.65,
   "end": 26.95,
   "parakeet": "Up to sixty percent commission, special trainings and global brand exposure.",
   "whisper": "Up to 60% commission, special trainings, and global brand exposure."
  },
  {
   "start": 27.77,
   "end": 31.66,
   "parakeet": "We're hiring secondary sales agents at Allegiance Real Estate.",
